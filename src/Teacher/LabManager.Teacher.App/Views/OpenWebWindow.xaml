<Window x:Class="LabManager.Teacher.App.Views.OpenWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mở trang web trên máy học sinh" Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🌐 MỞ TRANG WEB TỪ XA" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                <TextBlock Text="Gửi liên kết để các máy học sinh tự động khởi động Chrome và mở website."
                           Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#EFF6FF" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding TargetDescription}" Foreground="#0284C7" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- URL Input -->
        <TextBlock Grid.Row="1" Text="Đường dẫn trang web (URL):" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔗 " VerticalAlignment="Center" FontSize="14" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="#0F172A" BorderThickness="0"
                         FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center" Padding="2,4"/>
            </Grid>
        </Border>

        <!-- Presets Section -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Trang web học tập &amp; kiểm tra phổ biến (Nhấp để chọn nhanh):" 
                       Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="#FFFFFF" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,6" Margin="0,0,8,8" Cursor="Hand" FontSize="11">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Options -->
        <Border Grid.Row="4" Background="#FFFFFF" CornerRadius="8" Padding="12,10" Margin="0,0,0,16" BorderBrush="#CBD5E1" BorderThickness="1">
            <CheckBox IsChecked="{Binding ForceChrome}" Cursor="Hand" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Tự động mở bằng Google Chrome" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Ưu tiên tìm và kích hoạt Google Chrome trên máy học sinh (tự động chuyển sang trình duyệt mặc định nếu không có Chrome)" 
                               Foreground="#64748B" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </CheckBox>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy bỏ" Command="{Binding CancelCommand}"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontWeight="SemiBold"
                    Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="🌐 Mở trên máy học sinh" Command="{Binding SendCommand}"
                    Background="#0284C7" Foreground="White" FontWeight="Bold"
                    Padding="18,8" Cursor="Hand" BorderThickness="0" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
