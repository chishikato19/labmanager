<Window x:Class="LabManager.Teacher.App.Views.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều Khiển Từ Xa - LabManager PRO v1.3.2"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen"
        Focusable="True"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🖥️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MachineName}" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding IpAddress, StringFormat='({0})'}" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Border Background="#10B981" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="⚡ UDP Chuột Không Trễ (&lt; 1ms)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                    <Border Background="#0284C7" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="🔴 20 FPS Cực Nét Native" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#475569" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ResolutionText, StringFormat='📺 {0}'}" Foreground="#F8FAFC" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ScalingModeText}" Command="{Binding ToggleScalingModeCommand}"
                            Background="#334155" Foreground="White" FontSize="11" FontWeight="SemiBold"
                            Padding="8,4" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Nhấp để chuyển đổi giữa Sắc nét chữ (Linear) và Mượt mà (Bicubic)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button x:Name="BtnFullscreen" Content="⛶ Toàn màn hình (F11)" Click="BtnFullscreen_Click"
                            Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="11"
                            Padding="10,4" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Phóng to toàn màn hình để chữ và icon đạt độ sắc nét 100% Native">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Button Content="{Binding BroadcastButtonText}" Command="{Binding ToggleBroadcastThisStudentCommand}"
                            Background="{Binding BroadcastButtonColor}" Foreground="White" FontWeight="Bold" FontSize="11"
                            Padding="10,4" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Chiếu bài làm của học sinh này lên toàn bộ máy học sinh khác trong phòng">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                    <TextBlock Text="v1.3.3" Foreground="#64748B" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="💡 Bấm F11 để phóng to/thu nhỏ" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Remote Screen Container -->
        <Border Grid.Row="1" Background="#020617" ClipToBounds="True">
            <Grid>
                <!-- Trạng thái chờ khung hình -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="🔄 Đang đồng bộ luồng hình ảnh thời gian thực..." Foreground="#64748B" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Vui lòng chờ trong giây lát..." Foreground="#475569" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <Image x:Name="ScreenImage"
                       Source="{Binding CurrentScreen}"
                       Stretch="Uniform"
                       Focusable="True"
                       RenderOptions.BitmapScalingMode="{Binding ScalingMode}"
                       MouseMove="OnImageMouseMove"
                       MouseDown="OnImageMouseDown"
                       MouseUp="OnImageMouseUp"
                       MouseWheel="OnImageMouseWheel"
                       Cursor="Cross" />
            </Grid>
        </Border>
    </Grid>
</Window>
