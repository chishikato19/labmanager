<Window x:Class="LabManager.Teacher.App.Views.LaunchAppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khởi chạy ứng dụng trên máy học sinh" Height="520" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🚀 KHỞI CHẠY ỨNG DỤNG TỪ XA" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                <TextBlock Text="Chọn phần mềm học tập hoặc nhập tên ứng dụng để máy học sinh tự động mở ngay."
                           Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding TargetDescription}" Foreground="#059669" FontSize="11" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Presets Section -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Ứng dụng học tập thông dụng (Nhấp để chọn nhanh):" 
                       Foreground="#64748B" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Background="#FFFFFF" Foreground="#1E293B" BorderBrush="#CBD5E1" BorderThickness="1"
                                Padding="10,6" Margin="0,0,8,8" Cursor="Hand" FontSize="11"
                                ToolTip="{Binding Description}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Selected App Name or Path -->
        <TextBlock Grid.Row="2" Text="Tên ứng dụng hoặc đường dẫn thực thi:" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,4" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="💻 " VerticalAlignment="Center" FontSize="14" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding AppNameOrPath, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent" Foreground="#0F172A" BorderThickness="0"
                             FontSize="13" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" Padding="2,4"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="📂 Chọn file .exe..." Command="{Binding BrowseFileCommand}"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontWeight="SemiBold"
                    Padding="12,6" Cursor="Hand" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>

        <!-- Arguments (Optional) -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="Tham số dòng lệnh (Tùy chọn - ví dụ mở file tài liệu cụ thể):" Foreground="#64748B" FontSize="11" Margin="0,0,0,6"/>
            <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,4">
                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent" Foreground="#0F172A" BorderThickness="0"
                         FontSize="12" FontFamily="Consolas, Segoe UI" Padding="2,4"/>
            </Border>
            <TextBlock Text="💡 Gợi ý: Có thể gõ tên tệp như winword, excel, code, scratch, devcpp, mspaint, calc hoặc đường dẫn đầy đủ." 
                       Foreground="#64748B" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy bỏ" Command="{Binding CancelCommand}"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569" FontWeight="SemiBold"
                    Padding="16,8" Margin="0,0,10,0" Cursor="Hand" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="🚀 Mở ứng dụng ngay" Command="{Binding SendCommand}"
                    Background="#059669" Foreground="White" FontWeight="Bold"
                    Padding="18,8" Cursor="Hand" BorderThickness="0" FontSize="12">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
