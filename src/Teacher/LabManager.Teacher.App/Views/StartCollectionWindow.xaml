<Window x:Class="LabManager.Teacher.App.Views.StartCollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấu hình Mở Đợt Thu Bài" Height="490" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Folder Selection -->
            <RowDefinition Height="Auto"/>
            <!-- Session Title -->
            <RowDefinition Height="Auto"/>
            <!-- Options Box -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥 " FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="MỞ ĐỢT THU BÀI TẬP" FontSize="16" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Cấu hình thư mục lưu bài và quy cách đặt tên file thu từ các máy học sinh."
                           Foreground="#64748B" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Folder Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Thư mục lưu bài tập trên máy giáo viên:" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolderPath" IsReadOnly="True" FontSize="12" Height="34" Padding="8,6" VerticalAlignment="Center"
                         Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1">
                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                </TextBox>
                <Button Grid.Column="1" Content="📂 Duyệt thư mục..." Click="BtnBrowseFolder_Click"
                        Background="#0284C7" Foreground="White" FontWeight="SemiBold" FontSize="11"
                        Padding="14,0" Height="34" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Session Title -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Tiêu đề đợt thu (hiển thị trên nút máy học sinh):" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtSessionTitle" Text="Nộp bài cho Giáo viên" FontSize="12" Height="34" Padding="8,6"
                     Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1">
                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
            </TextBox>
        </StackPanel>

        <!-- Options Box -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="⚙️ QUY CÁCH LƯU FILE TỪ HỌC SINH" FontWeight="Bold" FontSize="11" Foreground="#475569" Margin="0,0,0,10"/>

                <!-- Checkbox 1: Prefix Machine Name -->
                <CheckBox x:Name="ChkPrefixMachineName" IsChecked="False" Click="Option_Changed" Margin="0,0,0,8" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kèm tên máy vào trước tên tệp" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                        <TextBlock Text=" (Ví dụ: PC01_bai1.cpp)" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </CheckBox>

                <!-- Checkbox 2: Separate Machine Folder -->
                <CheckBox x:Name="ChkSeparateMachineFolder" IsChecked="False" Click="Option_Changed" Margin="0,0,0,12" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tách mỗi máy vào một thư mục riêng" FontWeight="SemiBold" FontSize="12" Foreground="#1E293B"/>
                        <TextBlock Text=" (Ví dụ: PC01\bai1.cpp)" Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                </CheckBox>

                <!-- Note about Student Name -->
                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                    <TextBlock Text="ℹ️ Không kèm tên học sinh vào file và không đóng gói ZIP để giữ nguyên cấu trúc gốc phục vụ chấm bài."
                               Foreground="#166534" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <!-- Live Path Preview -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Mẫu vị trí lưu: " Foreground="#64748B" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtPathPreview" Text="ThưMục\bai1.cpp" Foreground="#4F46E5" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="4">
            <Button Content="Hủy bỏ" Click="BtnCancel_Click" HorizontalAlignment="Left"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569"
                    FontSize="12" FontWeight="SemiBold" Padding="16,8" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>

            <Button Content="🚀 BẮT ĐẦU THU BÀI" Click="BtnStart_Click" HorizontalAlignment="Right"
                    Background="#10B981" Foreground="White" FontSize="12" FontWeight="Bold"
                    Padding="22,8" Cursor="Hand" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
