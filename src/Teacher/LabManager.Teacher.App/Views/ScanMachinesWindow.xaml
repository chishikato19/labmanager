<Window x:Class="LabManager.Teacher.App.Views.ScanMachinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quét &amp; Tìm Kiếm Máy Học Sinh (Tìm Máy Thiếu)" Height="600" Width="680"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B"
        ResizeMode="CanResizeWithGrip" MinHeight="500" MinWidth="580">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🔍 QUÉT &amp; TÌM MÁY TRONG PHÒNG HỌC" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                <TextBlock Text="Dò tìm các máy học sinh bị thiếu, tự động kích hoạt nhận diện và kết nối lại."
                           Foreground="#64748B" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LocalNetworkInfo}" Foreground="#94A3B8" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="#047857">
                        <Run Text="Online: "/>
                        <Run Text="{Binding FoundCount, Mode=OneWay}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        <Run Text=" máy"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Action Buttons & Custom IP Group -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Quick LAN Scan -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Quét tự động toàn bộ phòng máy (Khuyên dùng)" FontWeight="SemiBold" FontSize="12" Foreground="#0F172A"/>
                        <TextBlock Text="Phát broadcast đa card mạng và rà quét đồng loạt các địa chỉ IP trong dải LAN 1..254"
                                   Foreground="#64748B" FontSize="11"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="🚀 Bắt đầu quét toàn mạng"
                            Command="{Binding ScanAllCommand}"
                            Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="12"
                            Padding="14,8" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>

                <Separator Background="#F1F5F9" Margin="0,4,0,12"/>

                <!-- Specific IP Scan -->
                <TextBlock Text="🎯 Quét theo địa chỉ IP cụ thể (Nếu biết IP của máy bị thiếu):" 
                           FontWeight="SemiBold" FontSize="12" Foreground="#0F172A" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <TextBox Text="{Binding TargetIpOrRange, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="12"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" Content="🔍 Quét IP này"
                            Command="{Binding ScanSpecificIpCommand}"
                            Background="#4F46E5" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="14,7" Cursor="Hand" BorderThickness="0">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>
                </Grid>
                <TextBlock Text="Ví dụ: 192.168.1.106 (IP đơn lẻ) hoặc 192.168.1.1-50 (dải IP) hoặc 192.168.1.0/24" 
                           Foreground="#94A3B8" FontSize="10" Margin="2,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Progress Bar & Status -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Grid Margin="0,0,0,4">
                <TextBlock Text="{Binding ProgressText}" Foreground="#334155" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0:F0}%'}" HorizontalAlignment="Right" Foreground="#0284C7" FontSize="11" FontWeight="Bold"/>
            </Grid>
            <ProgressBar Value="{Binding ProgressValue}" Height="8" Minimum="0" Maximum="100" 
                         Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0"/>
        </StackPanel>

        <!-- Log List -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📋 Nhật ký phát hiện &amp; kết nối máy:" 
                           FontWeight="SemiBold" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding ScanLog}"
                         Background="Transparent" BorderThickness="0"
                         FontSize="11" FontFamily="Consolas, Segoe UI">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Troubleshooting Tips Card -->
        <Border Grid.Row="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="💡 HƯỚNG DẪN KHI VẪN BỊ THIẾU MÁY:" Foreground="#1E40AF" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="1. Đảm bảo máy học sinh thứ 6 đã cài và đang chạy LabManager Student (xem khay icon góc phải Taskbar)." 
                           Foreground="#1E3A8A" FontSize="10.5" Margin="0,1"/>
                <TextBlock Text="2. Kiểm tra dây mạng LAN hoặc sóng Wi-Fi: Máy học sinh phải cùng mạng nội bộ với máy Giáo viên." 
                           Foreground="#1E3A8A" FontSize="10.5" Margin="0,1"/>
                <TextBlock Text="3. Tường lửa Windows (Firewall): Cần cho phép LabManager Student chạy trên mạng Private/Public (cổng UDP 9000 &amp; TCP 9001)." 
                           Foreground="#1E3A8A" FontSize="10.5" Margin="0,1"/>
                <TextBlock Text="4. Nếu máy cài bằng Ghost / Clone ổ cứng: Kiểm tra xem Tên máy (Computer Name) có bị trùng với máy khác trong phòng không." 
                           Foreground="#1E3A8A" FontSize="10.5" Margin="0,1"/>
            </StackPanel>
        </Border>

        <!-- Bottom Actions -->
        <Grid Grid.Row="5">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#475569" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Đóng" Click="CloseButton_Click"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#475569"
                        FontWeight="SemiBold" FontSize="12" Padding="16,6" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
