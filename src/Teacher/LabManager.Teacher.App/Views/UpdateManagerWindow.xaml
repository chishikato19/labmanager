<Window x:Class="LabManager.Teacher.App.Views.UpdateManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trung tâm Cập nhật Phiên bản (GitHub &amp; LAN)" 
        Height="720" Width="920" MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Rounded Progress Bar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" ClipToBounds="True">
                            <Grid x:Name="TemplateRoot">
                                <Border x:Name="PART_Track" />
                                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="6"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Git Release Info Card -->
            <RowDefinition Height="*"/>    <!-- Student Deployment Section -->
            <RowDefinition Height="Auto"/> <!-- Footer Actions -->
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 TRUNG TÂM CẬP NHẬT PHIÊN BẢN" FontSize="18" FontWeight="Bold" Foreground="#7C3AED"/>
                    <Border Background="#F3E8FF" BorderBrush="#C084FC" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GitHub &amp; LAN Relay" Foreground="#7E22CE" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Tự động kiểm tra bản phát hành trên GitHub, nâng cấp máy Giáo viên và phát hành đồng bộ cho Học sinh qua mạng LAN."
                           Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="🔄 Kiểm tra lại từ Git" Command="{Binding CheckUpdatesCommand}"
                        Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569" Padding="12,6"/>
            </StackPanel>
        </Grid>

        <!-- 2. GITHUB & TEACHER SECTION -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Versions & Teacher Update -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="1. Phiên bản &amp; Nâng cấp máy Giáo viên" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,10"/>
                    
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Giáo viên hiện tại:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentTeacherVersion}" FontWeight="Bold" Foreground="#0F172A" FontSize="12"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Bản mới nhất trên Git:" Foreground="#64748B" FontSize="12"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding LatestVersion}" FontWeight="Bold" Foreground="#7C3AED" FontSize="12"/>
                            <TextBlock Text="{Binding PublishedDate, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="11" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trạng thái:" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding CheckStatus}" TextWrapping="Wrap" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                    </Grid>

                    <!-- Teacher Update Button & Progress -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel>
                            <Button Content="⚡ Nâng cấp máy Giáo viên ngay"
                                    Command="{Binding UpdateTeacherCommand}"
                                    IsEnabled="{Binding CanUpdateTeacher}"
                                    Background="#7C3AED" BorderBrush="#6D28D9" Foreground="White"
                                    Padding="12,8" HorizontalAlignment="Stretch"/>
                            
                            <ProgressBar Value="{Binding TeacherProgress}" Maximum="100" Margin="0,8,0,0"
                                         Visibility="{Binding IsTeacherUpdating, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding TeacherStatusMessage}" FontSize="11" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsTeacherUpdating, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Column: Changelog / Release Notes -->
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="📝 Thông tin bản phát hành: " FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <TextBlock Text="{Binding ReleaseTitle}" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" MaxHeight="110" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" FontSize="11" Foreground="#334155" LineHeight="16"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 3. STUDENT LAN DEPLOYMENT SECTION -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Source selection -->
                    <RowDefinition Height="Auto"/> <!-- Selection controls & counters -->
                    <RowDefinition Height="*"/>    <!-- Student Table -->
                    <RowDefinition Height="Auto"/> <!-- Student Progress -->
                </Grid.RowDefinitions>

                <!-- Step 2 Header & Source Selection -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="2. Nâng cấp đồng bộ cho toàn bộ phòng máy Học sinh (qua LAN)" FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,8"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <RadioButton Content="🌐 Tự động tải bản mới nhất từ GitHub Release (Khuyên dùng)"
                                     IsChecked="{Binding IsSourceGit, Mode=TwoWay}"
                                     FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,24,0"/>
                        <RadioButton Content="📁 Sử dụng tệp cài đặt có sẵn trên máy tính (.exe)..."
                                     IsChecked="{Binding IsSourceLocal, Mode=TwoWay}"
                                     FontWeight="SemiBold" Foreground="#1E293B"/>
                    </StackPanel>

                    <!-- Local file chooser (only when IsSourceLocal is checked) -->
                    <Grid Margin="0,6,0,0" Visibility="{Binding IsSourceLocal, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LocalFilePath, UpdateSourceTrigger=PropertyChanged}" 
                                 IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,10,0" Padding="8,5"
                                 Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                        <Button Grid.Column="1" Content="📁 Duyệt tệp..." Command="{Binding BrowseLocalFileCommand}"
                                Background="#0284C7" BorderBrush="#0369A1" Foreground="White" Padding="12,5"/>
                    </Grid>
                </StackPanel>

                <!-- Target selection toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Chọn tất cả" Command="{Binding SelectAllCommand}" Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                        <Button Content="Bỏ chọn" Command="{Binding DeselectAllCommand}" Padding="8,4" FontSize="11"/>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12">
                            <Run Text="Đã chọn: " Foreground="#64748B"/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}" FontWeight="Bold" Foreground="#7C3AED"/>
                            <Run Text="/" Foreground="#64748B"/>
                            <Run Text="{Binding TotalOnlineCount, Mode=OneWay}" FontWeight="Bold" Foreground="#1E293B"/>
                            <Run Text=" máy học sinh trực tuyến" Foreground="#64748B"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- Students DataGrid / Table -->
                <Border Grid.Row="2" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6">
                    <DataGrid ItemsSource="{Binding Targets}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="45">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Chọn" FontSize="11" HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tên máy học sinh" Binding="{Binding MachineName}" Width="160" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Địa chỉ IP" Binding="{Binding IpAddress}" Width="130"/>
                            <DataGridTextColumn Header="Phiên bản app" Binding="{Binding AppVersion}" Width="110"/>
                            
                            <DataGridTemplateColumn Header="Trạng thái nâng cấp" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Progress & Status Info -->
                <StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <ProgressBar Value="{Binding StudentProgress}" Maximum="100"
                                 Visibility="{Binding IsStudentUpdating, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding StudentStatusMessage}" FontSize="12" Foreground="#475569" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. FOOTER ACTIONS -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Lưu ý: Học sinh không cần Internet. Máy giáo viên tự tải và phân phối qua mạng LAN an toàn."
                       Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>

            <Button Grid.Column="1" Content="🚀 Bắt đầu nâng cấp máy Học sinh"
                    Command="{Binding UpdateStudentsCommand}"
                    IsEnabled="{Binding CanUpdateStudents}"
                    Background="#7C3AED" BorderBrush="#6D28D9" Foreground="White"
                    FontWeight="Bold" Padding="18,8" Margin="0,0,10,0"/>

            <Button Grid.Column="2" Content="Đóng" Command="{Binding CloseCommand}"
                    Background="#FFFFFF" BorderBrush="#CBD5E1" Foreground="#475569" Padding="16,8"/>
        </Grid>
    </Grid>
</Window>
