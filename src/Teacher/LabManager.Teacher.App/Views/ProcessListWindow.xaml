<Window x:Class="LabManager.Teacher.App.Views.ProcessListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="15" FontWeight="Bold" Margin="0,0,0,12" Foreground="#0284C7"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" RowBackground="#FFFFFF"
                  AlternatingRowBackground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                <DataGridTextColumn Header="Tên tiến trình" Binding="{Binding ProcessName}" Width="150"/>
                <DataGridTextColumn Header="Tiêu đề cửa sổ" Binding="{Binding MainWindowTitle}" Width="*"/>
                <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryUsageMb}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="🔄 Làm mới" Command="{Binding RefreshCommand}"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontWeight="SemiBold"
                    Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="🛑 Kết thúc tác vụ" Command="{Binding KillSelectedCommand}"
                    Background="#DC2626" Foreground="White" FontWeight="SemiBold"
                    Padding="14,6" Cursor="Hand" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
