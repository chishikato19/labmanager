<Window x:Class="LabManager.Teacher.App.Views.WebFilterConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thiết lập chặn trang web (Web Filtering)" Height="380" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC" Foreground="#1E293B">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🌐 CẤU HÌNH BỘ LỌC TRANG WEB" FontSize="14" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" Text="Nhập các tên miền website cần chặn (phân cách bằng dấu phẩy). Hệ thống sẽ chặn truy cập ở cấp độ phân giải mạng (Hosts DNS) và giám sát tiêu đề trình duyệt."
                   TextWrapping="Wrap" Foreground="#64748B" FontSize="11" Margin="0,0,0,10"/>

        <TextBox Grid.Row="2" Text="{Binding DomainBlacklistText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="8" FontFamily="Consolas" FontSize="12"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Gỡ bỏ chặn web" Command="{Binding ClearCommand}"
                    Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontWeight="SemiBold"
                    Padding="14,6" Margin="0,0,10,0" Cursor="Hand">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
            <Button Content="🌐 Áp dụng bộ lọc" Command="{Binding ApplyCommand}"
                    Background="#0284C7" Foreground="White" FontWeight="Bold"
                    Padding="14,6" Cursor="Hand" BorderThickness="0">
                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
