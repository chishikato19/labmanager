<Window x:Class="LabManager.Teacher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LabManager.Teacher.App.ViewModels"
        mc:Ignorable="d"
        Title="LabManager PRO v1.3.2 - Bảng Điều Khiển Phòng Máy" 
        Height="760" Width="1240"
        MinHeight="600" MinWidth="950"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:DashboardViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <!-- Modern TopBar Dropdown MenuItem Style (No icon gutter, clean light theme) -->
        <Style x:Key="TopBarMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="{TemplateBinding Background}" 
                                TextElement.Foreground="{TemplateBinding Foreground}" 
                                CornerRadius="6" Margin="1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- Modern Dropdown Menu Style (Light mode, no white gutter) -->
        <Style x:Key="TopBarContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource TopBarMenuItemStyle}"/>
                <Style TargetType="Separator" BasedOn="{StaticResource TopBarMenuSeparatorStyle}"/>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F8" Command="{Binding ToggleLaserPointerCommand}" />
        <KeyBinding Modifiers="Control" Key="L" Command="{Binding ToggleLaserPointerCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: GROUPED ACTION BUTTONS (LIGHT THEME) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo & Room Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="8" Background="#2563EB" Margin="0,0,15,0">
                        <TextBlock Text="LM" Foreground="White" FontWeight="Bold" FontSize="18" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAB MANAGER PRO v1.3.2" Foreground="#0F172A" FontWeight="Bold" FontSize="16" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding RoomName}" Foreground="#64748B" FontSize="12" Margin="0,0,10,0"/>
                            <TextBlock Text="•" Foreground="#94A3B8" FontSize="12" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding TeacherName, StringFormat='GV: {0}'}" Foreground="#64748B" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Grouped Action Buttons & Stats Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- NHÓM 1: GIẢNG DẠY (Chiếu màn hình, Bút Laser) -->
                    <Button Content="📡 Giảng dạy  ▾"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="DropdownGroupButton_Click"
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Nhóm công cụ bài giảng: Chiếu màn hình giáo viên, Bút laser (F8)">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource TopBarContextMenuStyle}">
                                <MenuItem Header="{Binding PlacementTarget.Tag.BroadcastButtonText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Command="{Binding PlacementTarget.Tag.ToggleBroadcastCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Bật / Tắt truyền màn hình của giáo viên đến toàn bộ máy học sinh"
                                          Foreground="#0284C7"/>
                                <MenuItem Header="{Binding PlacementTarget.Tag.LaserButtonText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Command="{Binding PlacementTarget.Tag.ToggleLaserPointerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Bật / Tắt Bút Chiếu Laser cho bài giảng (Phím tắt: F8 hoặc Ctrl+L)"
                                          Foreground="#E11D48"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- NHÓM 2: BÀI TẬP & TÁC VỤ (Gửi/Thu bài, Mở Web, Mở App, Cài hình nền) -->
                    <Button Content="📁 Bài tập &amp; Tác vụ  ▾"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="DropdownGroupButton_Click"
                            Background="#4F46E5" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Nhóm phân phối bài tập, thu bài, mở ứng dụng, website và cài đặt hình nền máy học sinh">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource TopBarContextMenuStyle}">
                                <MenuItem Header="📤 Gửi bài tập tới học sinh..."
                                          Command="{Binding PlacementTarget.Tag.DistributeFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Gửi tệp bài tập tới các máy đã chọn (hoặc toàn bộ phòng máy)"
                                          Foreground="#4338CA"/>
                                <MenuItem Header="📥 Mở đợt thu bài (Chọn thư mục lưu)..."
                                          Command="{Binding PlacementTarget.Tag.CollectFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Mở đợt thu bài: hiện nút nộp bài trên màn hình học sinh để học sinh chọn file nộp lên"
                                          Foreground="#0284C7"/>
                                <MenuItem Header="⏹️ Kết thúc đợt thu bài"
                                          Command="{Binding PlacementTarget.Tag.StopCollectFilesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Dừng đợt thu bài và ẩn nút nộp bài trên màn hình học sinh"
                                          Foreground="#DC2626"/>
                                <MenuItem Header="📂 Mở thư mục bài nộp..."
                                          Command="{Binding PlacementTarget.Tag.OpenCollectionFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Mở thư mục chứa các bài học sinh đã nộp trên máy giáo viên"
                                          Foreground="#059669"/>
                                <Separator/>
                                <MenuItem Header="🌐 Mở trang Web đồng loạt..."
                                          Command="{Binding PlacementTarget.Tag.OpenWebWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Gửi đường link trang web và tự động mở Google Chrome trên máy học sinh"
                                          Foreground="#0369A1"/>
                                <MenuItem Header="🚀 Mở Ứng dụng đồng loạt..."
                                          Command="{Binding PlacementTarget.Tag.OpenLaunchAppWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Chọn và tự động khởi chạy ứng dụng (Word, Excel, VS Code, Scratch...) trên máy học sinh"
                                          Foreground="#047857"/>
                                <Separator/>
                                <MenuItem Header="🖼️ Cài hình nền máy học sinh..."
                                          Command="{Binding PlacementTarget.Tag.SetWallpaperCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Chọn tệp ảnh (.jpg, .png) và áp dụng làm hình nền Desktop máy học sinh ngay lập tức"
                                          Foreground="#B45309"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- NHÓM 3: KỶ LUẬT & AN TOÀN (Khóa/Mở máy, Chặn web, Chặn ứng dụng) -->
                    <Button Content="🔒 Kỷ luật &amp; An toàn  ▾"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="DropdownGroupButton_Click"
                            Background="#0D9488" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Nhóm kiểm soát sự tập trung: Khóa chuột/phím, cấu hình chặn web và ứng dụng cấm">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource TopBarContextMenuStyle}">
                                <MenuItem Header="🔒 Khóa màn hình (Chuột &amp; Phím)"
                                          Command="{Binding PlacementTarget.Tag.LockAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Khóa chuột và bàn phím các máy đã chọn (hoặc toàn bộ phòng máy)"
                                          Foreground="#B91C1C"/>
                                <MenuItem Header="🔓 Mở khóa màn hình"
                                          Command="{Binding PlacementTarget.Tag.UnlockAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Mở khóa các máy đã chọn (hoặc tất cả nếu không chọn máy nào)"
                                          Foreground="#047857"/>
                                <Separator/>
                                <MenuItem Header="🛡️ Quản lý danh sách ứng dụng cấm..."
                                          Command="{Binding PlacementTarget.Tag.OpenBlacklistConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Cấu hình danh sách ứng dụng cấm chạy trong giờ học"
                                          Foreground="#334155"/>
                                <MenuItem Header="🌐 Quản lý danh sách website bị chặn..."
                                          Command="{Binding PlacementTarget.Tag.OpenWebFilterConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Cấu hình danh sách tên miền website bị chặn truy cập"
                                          Foreground="#0369A1"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- NHÓM 4: NGUỒN MÁY & HỆ THỐNG (Bật/Tắt/Reset máy, Cài phần mềm, Nâng cấp) -->
                    <Button Content="⚡ Nguồn máy  ▾"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                            Click="DropdownGroupButton_Click"
                            Background="#DC2626" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Nhóm quản trị nguồn và phần mềm hệ thống: Bật, Tắt, Reset, Cài phần mềm qua mạng">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource TopBarContextMenuStyle}">
                                <MenuItem Header="⚡ Bật máy từ xa (Wake-on-LAN)"
                                          Command="{Binding PlacementTarget.Tag.WakeAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Gửi gói tin Magic Packet đánh thức các máy học sinh đang tắt"
                                          Foreground="#B45309"/>
                                <Separator/>
                                <MenuItem Header="🔄 Khởi động lại máy (Reset)"
                                          Command="{Binding PlacementTarget.Tag.RestartAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Khởi động lại các máy đã chọn (hoặc tất cả)"
                                          Foreground="#6D28D9"/>
                                <MenuItem Header="🛑 Tắt máy toàn phòng / đã chọn"
                                          Command="{Binding PlacementTarget.Tag.ShutdownAllCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Tắt các máy đã chọn (hoặc tất cả)"
                                          Foreground="#B91C1C"/>
                                <Separator/>
                                <MenuItem Header="📦 Cài đặt phần mềm cho máy HS..."
                                          Command="{Binding PlacementTarget.Tag.DeploySoftwareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Phân phối và cài đặt ngầm phần mềm (.msi, .exe) xuống máy học sinh qua mạng LAN"
                                          Foreground="#0284C7"/>
                                <MenuItem Header="🚀 Trung tâm Cập nhật Phiên bản (Git &amp; LAN)..."
                                          Command="{Binding PlacementTarget.Tag.OpenUpdateManagerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          ToolTip="Kiểm tra bản cập nhật mới từ GitHub, nâng cấp máy Giáo viên và phát hành tới Học sinh qua LAN"
                                          Foreground="#7E22CE"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <!-- NÚT TRỰC TIẾP: CẬP NHẬT PHIÊN BẢN (GIT & LAN) -->
                    <Button Content="🚀 Cập nhật (Git)"
                            Command="{Binding OpenUpdateManagerCommand}"
                            Background="#9333EA" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Trung tâm cập nhật: Kiểm tra bản mới trên GitHub, nâng cấp Giáo viên và phát hành tới Học sinh qua LAN">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <!-- NHÓM 5: TIN NHẮN & THÔNG BÁO (Nút trực tiếp) -->
                    <Button Content="💬 Tin nhắn &amp; Thông báo"
                            Command="{Binding OpenBroadcastChatCommand}"
                            Background="#7C3AED" Foreground="White" FontWeight="SemiBold" FontSize="12"
                            Padding="12,7" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Gửi tin nhắn trao đổi hoặc phát thông báo nổi toàn phòng máy">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    </Button>

                    <Border Background="#F8FAFC" CornerRadius="18" Padding="12,5" BorderBrush="#CBD5E1" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Foreground="#334155" FontSize="12" FontWeight="SemiBold">
                                <Run Text="Online: "/>
                                <Run Text="{Binding OnlineCount, Mode=OneWay}" Foreground="#059669" FontWeight="Bold"/>
                                <Run Text="/" Foreground="#94A3B8"/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}" Foreground="#64748B"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB-TOOLBAR: SELECTION, FILTER & SORTING (LIGHT THEME) -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Multi-Selection Controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="☑️ Chọn tất cả" Command="{Binding SelectAllCommand}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                            Foreground="#1E293B" FontSize="11" Padding="9,4" Margin="0,0,6,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>

                    <Button Content="✖ Bỏ chọn" Command="{Binding DeselectAllCommand}"
                            Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                            Foreground="#64748B" FontSize="11" Padding="9,4" Margin="0,0,12,0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    </Button>

                    <Border Background="#0284C7" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Foreground="White" FontSize="11" FontWeight="Bold">
                            <Run Text="Đã chọn: "/>
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text=" máy"/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="💡 Chọn từng máy qua ô tích hoặc nhấp đúp để điều khiển từ xa (UltraViewer)" 
                               Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Online Filter & Sorting Options -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding ShowOnlyOnline}" VerticalAlignment="Center" Margin="0,0,20,0" Cursor="Hand">
                        <TextBlock Text="🟢 Chỉ hiện máy Online" Foreground="#1E293B" FontSize="12" FontWeight="SemiBold"/>
                    </CheckBox>

                    <TextBlock Text="Sắp xếp:" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox SelectedIndex="{Binding SelectedSortIndex}" Width="155" Height="26" FontSize="11" VerticalAlignment="Center">
                        <ComboBoxItem Content="Tên máy (A - Z)" />
                        <ComboBoxItem Content="Tên máy (Z - A)" />
                        <ComboBoxItem Content="Địa chỉ IP" />
                        <ComboBoxItem Content="Trực tuyến lên đầu" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT: STUDENT GRID -->
        <ScrollViewer Grid.Row="2" Background="#F1F5F9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15">
            <StackPanel>
                <!-- Active Collection Banner -->
                <Border Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8"
                        Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding IsCollectingFiles, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📥 ĐANG MỞ ĐỢT THU BÀI TẬP" FontWeight="Bold" Foreground="#047857" FontSize="13" VerticalAlignment="Center"/>
                            <TextBlock Text="  •  Thư mục lưu: " Foreground="#065F46" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentCollectionFolder}" FontWeight="SemiBold" Foreground="#0F172A" FontSize="12" VerticalAlignment="Center"/>
                            <Border Background="#10B981" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CollectedCount, StringFormat='Đã nhận: {0} bài'}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📂 Mở thư mục bài nộp" Command="{Binding OpenCollectionFolderCommand}"
                                    Background="#059669" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                    Padding="10,5" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                            <Button Content="⏹️ Kết thúc đợt thu bài" Command="{Binding StopCollectFilesCommand}"
                                    Background="#DC2626" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                    Padding="10,5" Cursor="Hand" BorderThickness="0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding DisplayedStudents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="265" Height="215" Margin="8" 
                                CornerRadius="10" Background="#FFFFFF"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                MouseEnter="StudentCard_MouseEnter"
                                MouseLeave="StudentCard_MouseLeave">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#0284C7"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="#F0F9FF"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#38BDF8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftDoubleClick" 
                                              Command="{Binding DataContext.StartRemoteControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>

                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource TopBarContextMenuStyle}">
                                    <MenuItem Header="🎮 Điều khiển từ xa (UltraViewer)" 
                                              Command="{Binding PlacementTarget.Tag.StartRemoteControlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#0284C7" FontWeight="Bold"/>
                                    <MenuItem Header="📡 Chiếu bài làm của học sinh này cho cả lớp" 
                                              Command="{Binding PlacementTarget.Tag.BroadcastStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#E11D48" FontWeight="Bold"/>
                                    <MenuItem Header="🔒 Khóa / Mở khóa máy này" 
                                              Command="{Binding PlacementTarget.Tag.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#0F172A"/>
                                    <MenuItem Header="📋 Xem ứng dụng đang chạy..." 
                                              Command="{Binding PlacementTarget.Tag.ViewProcessesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#0891B2"/>
                                    <MenuItem Header="💬 Nhắn tin riêng..." 
                                              Command="{Binding PlacementTarget.Tag.OpenStudentChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#7C3AED"/>
                                    <Separator/>
                                    <MenuItem Header="🌐 Mở trang web trên máy này..." 
                                              Command="{Binding PlacementTarget.Tag.OpenStudentWebCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#0284C7"/>
                                    <MenuItem Header="🚀 Mở ứng dụng trên máy này..." 
                                              Command="{Binding PlacementTarget.Tag.OpenStudentAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#059669"/>
                                    <MenuItem Header="🖼️ Cài hình nền máy này..." 
                                              Command="{Binding PlacementTarget.Tag.SetStudentWallpaperCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#D97706"/>
                                    <MenuItem Header="📦 Cài phần mềm máy này..." 
                                              Command="{Binding PlacementTarget.Tag.DeployStudentSoftwareCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#0284C7"/>
                                    <MenuItem Header="🚀 Cập nhật phiên bản máy này (Git/LAN)..." 
                                              Command="{Binding PlacementTarget.Tag.OpenUpdateManagerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#7E22CE"/>
                                    <Separator/>
                                    <MenuItem Header="◀ Chuyển vị trí sang trái" 
                                              Command="{Binding PlacementTarget.Tag.MoveStudentLeftCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#475569"/>
                                    <MenuItem Header="▶ Chuyển vị trí sang phải" 
                                              Command="{Binding PlacementTarget.Tag.MoveStudentRightCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#475569"/>
                                    <Separator/>
                                    <MenuItem Header="⚡ Bật máy (Wake-on-LAN)" 
                                              Command="{Binding PlacementTarget.Tag.WakeStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#D97706"/>
                                    <MenuItem Header="🔄 Khởi động lại máy" 
                                              Command="{Binding PlacementTarget.Tag.RestartStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#7C3AED"/>
                                    <MenuItem Header="🛑 Tắt máy này" 
                                              Command="{Binding PlacementTarget.Tag.ShutdownStudentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" Foreground="#DC2626"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Selection, Machine Name & Quick Buttons -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Name + Selection Checkbox -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                                  ToolTip="Chọn / Bỏ chọn máy này"/>
                                        <TextBlock Text="{Binding MachineName}" Foreground="#0F172A" FontWeight="Bold" FontSize="13" 
                                                   TextTrimming="CharacterEllipsis" MaxWidth="110" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Quick Actions + Status Badge -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🎮" ToolTip="Điều khiển từ xa (UltraViewer)"
                                                Command="{Binding DataContext.StartRemoteControlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="#0284C7" Foreground="White" FontSize="10"
                                                Padding="4,2" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>

                                        <Button Content="📡" ToolTip="Phát màn hình học sinh này cho toàn bộ học sinh khác"
                                                Command="{Binding DataContext.BroadcastStudentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="#E11D48" Foreground="White" FontSize="10"
                                                Padding="4,2" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>

                                        <Button Content="🔒" ToolTip="Khóa / Mở khóa máy"
                                                Command="{Binding DataContext.ToggleLockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Foreground="#334155" FontSize="10"
                                                Padding="4,2" Margin="0,0,4,0" Cursor="Hand">
                                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                        </Button>

                                        <Border CornerRadius="4" Padding="5,2" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,4,0"
                                                Visibility="{Binding HasSubmitted, Converter={StaticResource BoolToVisConverter}}"
                                                ToolTip="{Binding SubmittedFileName, StringFormat='Đã nộp bài: {0}'}">
                                            <TextBlock Text="✅ Đã nộp" Foreground="#047857" FontSize="10" FontWeight="Bold"/>
                                        </Border>

                                        <Border CornerRadius="4" Padding="5,2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Screen Preview with Hover Zoom Tooltip -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" ClipToBounds="True"
                                        ToolTipService.InitialShowDelay="80" ToolTipService.BetweenShowDelay="30" ToolTipService.ShowDuration="30000" Cursor="Hand">
                                    <Border.ToolTip>
                                        <ToolTip Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="2" Padding="14">
                                            <StackPanel Width="780">
                                                <Grid Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding MachineName}" Foreground="#0F172A" FontWeight="Bold" FontSize="16"/>
                                                        <TextBlock Text="{Binding CurrentUser, StringFormat=' - 👤 {0}'}" Foreground="#475569" FontSize="14" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding AppVersion, StringFormat=' (v{0})'}" Foreground="#7C3AED" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border Background="#DC2626" CornerRadius="4" Padding="7,2" Margin="0,0,10,0">
                                                            <TextBlock Text="🔴 TRỰC TIẾP (LIVE HD)" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding IpAddress, StringFormat='IP: {0}'}" Foreground="#0284C7" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border Background="#020617" CornerRadius="8" Height="438" ClipToBounds="True" BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock Text="💻 Đang truyền luồng hình ảnh trực tiếp thời gian thực..." Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" 
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                                                    </Grid>
                                                </Border>
                                                <Grid Margin="0,8,0,0">
                                                    <TextBlock Text="💡 Nhấp đúp chuột để Điều Khiển Từ Xa (UltraViewer tức thì)" 
                                                               Foreground="#0284C7" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <TextBlock Text="⚡ Trực tiếp 20 FPS - Cực nét Native" Foreground="#059669" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>

                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="💻" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="Chờ màn hình" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Image Source="{Binding ThumbnailImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                </Border>

                                <!-- Footer: User, Position Controls, IP -->
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentUser, StringFormat='👤 {0}'}" 
                                                   Foreground="#475569" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding AppVersion, StringFormat=' (v{0})'}" 
                                                   Foreground="#7C3AED" FontSize="9" Margin="2,0,0,0" ToolTip="Phiên bản phần mềm"/>
                                    </StackPanel>

                                    <!-- Quick Manual Reorder Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center">
                                        <Button Content="◀" ToolTip="Dời sang trái"
                                                Command="{Binding DataContext.MoveStudentLeftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#64748B" FontSize="9" Padding="2,0" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="▶" ToolTip="Dời sang phải"
                                                Command="{Binding DataContext.MoveStudentRightCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="#64748B" FontSize="9" Padding="2,0" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding IpAddress}" Foreground="#64748B" FontSize="10"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- STATUS BAR (LIGHT THEME) -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                           Foreground="#334155" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="v1.3.2" Foreground="#64748B" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Sẵn sàng kết nối" Foreground="#059669" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
