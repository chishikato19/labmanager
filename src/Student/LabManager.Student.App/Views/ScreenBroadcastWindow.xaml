<Window x:Class="LabManager.Student.App.Views.ScreenBroadcastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Bài giảng từ Giáo viên" 
        Height="700" Width="1100"
        WindowStyle="None"
        WindowState="Maximized"
        Topmost="True"
        Background="#000000">

    <Grid>
        <!-- Teacher Live Broadcast Image -->
        <Image x:Name="ImgScreen" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Top Floating Notification Bar (ẩn để không che thao tác giáo viên) -->
        <Border x:Name="NotificationBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,15,0,0"
                Background="#CC0F172A" CornerRadius="20" Padding="18,8" 
                BorderBrush="#334155" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBroadcastTitle" Text="Đang theo dõi màn hình bài giảng của Giáo viên" 
                           Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text=" • v1.3.2" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
