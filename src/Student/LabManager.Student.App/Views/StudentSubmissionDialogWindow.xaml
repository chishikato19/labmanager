<Window x:Class="LabManager.Student.App.Views.StudentSubmissionDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nộp bài cho Giáo viên"
        Width="520" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
    </Window.Resources>

    <Grid Margin="16">
        <Border Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5" CornerRadius="16"
                Effect="{StaticResource DialogShadow}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Content -->
                    <RowDefinition Height="*"/>
                    <!-- Footer Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Border Grid.Row="0" Background="#1E293B" Padding="18,14" BorderBrush="#334155" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#312E81" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8"
                                    Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="📥" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NỘP BÀI TẬP CHO GIÁO VIÊN" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="TxtSessionTitle" Text="Đợt thu bài đang mở" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="1" Content="✕" Click="BtnClose_Click"
                                Background="Transparent" Foreground="#94A3B8" FontSize="14" FontWeight="Bold"
                                Width="32" Height="32" Cursor="Hand" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="16"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- MAIN BODY -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <!-- Student Name & Machine Info -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Họ và tên học sinh / Mã số:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox x:Name="TxtStudentName" Height="34" FontSize="13" Padding="8,6"
                                         Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#475569" BorderThickness="1">
                                    <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                </TextBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Máy thực hành:" Foreground="#94A3B8" FontSize="12" Margin="0,0,0,4"/>
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Height="34" Padding="8,0">
                                    <TextBlock x:Name="TxtMachineName" Text="PC-01" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- File Selection Drag & Drop Zone -->
                        <TextBlock Text="Tệp bài làm nộp lên:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border x:Name="DropZone" Height="110" CornerRadius="10"
                                Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1.5"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                                Cursor="Hand" MouseLeftButtonDown="DropZone_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📁" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Kéo &amp; thả tệp bài làm vào đây, hoặc nhấn để chọn" 
                                           Foreground="#93C5FD" FontSize="12" FontWeight="Medium" HorizontalAlignment="Center"/>
                                <TextBlock Text="Hỗ trợ: Word, PDF, Excel, Code (Py, C++, Pas...), Tệp nén ZIP" 
                                           Foreground="#64748B" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected Files Header and Clear Action -->
                        <Grid Margin="0,12,0,4">
                            <TextBlock Text="Danh sách tệp đã chọn:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"/>
                            <Button Content="Xóa danh sách" Click="BtnClearFiles_Click"
                                    HorizontalAlignment="Right" Background="Transparent" Foreground="#F87171" FontSize="11"
                                    Cursor="Hand" BorderThickness="0"/>
                        </Grid>

                        <!-- Files List Container -->
                        <Border Background="#131C2E" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" 
                                MinHeight="75" MaxHeight="120" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FilesPanel">
                                    <TextBlock x:Name="TxtNoFiles" Text="Chưa chọn tệp nào. Vui lòng bấm vào khung trên để chọn tệp." 
                                               Foreground="#64748B" FontSize="11" FontStyle="Italic" Margin="8,8,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Optional Note -->
                        <TextBlock Text="Ghi chú thêm (Tùy chọn):" Foreground="#94A3B8" FontSize="11" Margin="0,12,0,4"/>
                        <TextBox x:Name="TxtNote" Height="30" FontSize="12" Padding="8,4"
                                 Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1"
                                 ToolTip="Ghi chú thêm cho giáo viên nếu có">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                        </TextBox>

                        <!-- Status Message / Alert -->
                        <Border x:Name="StatusBorder" Margin="0,12,0,0" Padding="12,8" CornerRadius="8"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng nộp bài." 
                                       Foreground="#CBD5E1" FontSize="11" FontWeight="Medium" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- FOOTER -->
                <Border Grid.Row="2" Background="#1E293B" Padding="18,14" BorderBrush="#334155" BorderThickness="0,1,0,0">
                    <Grid>
                        <Button Content="Đóng" Click="BtnClose_Click" HorizontalAlignment="Left"
                                Background="#334155" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"
                                Padding="16,8" Cursor="Hand" BorderThickness="0">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>

                        <Button x:Name="BtnSubmit" Content="🚀 NỘP BÀI NGAY" Click="BtnSubmit_Click" HorizontalAlignment="Right"
                                Background="#2563EB" Foreground="White" FontSize="12" FontWeight="Bold"
                                Padding="22,8" Cursor="Hand" BorderThickness="0" IsEnabled="False">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
