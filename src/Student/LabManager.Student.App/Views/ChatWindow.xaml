<Window x:Class="LabManager.Student.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trao đổi với Giáo viên (v1.3.2)" Height="450" Width="380"
        WindowStartupLocation="Manual" Topmost="True"
        Background="#0F172A" Foreground="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💬" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Hỏi bài Giáo viên" FontWeight="Bold" FontSize="13" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    <Border Background="#334155" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.3.2" FontSize="10" Foreground="#94A3B8"/>
                    </Border>
                </StackPanel>

                <!-- Nút Tắt / Đóng Bảng Chat (Kiểm soát theo tùy chọn của Giáo viên) -->
                <Button Grid.Column="1" Content="✕ Đóng" Command="{Binding RequestCloseCommand}"
                        Background="#334155" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"
                        Padding="8,3" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="ToolTip" Value="Đóng bảng chat"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllowCloseChat}" Value="False">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="ToolTip" Value="Giáo viên không cho phép tắt bảng chat"/>
                                    <Setter Property="Opacity" Value="0.4"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- MESSAGES LIST -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4" Padding="10,8" CornerRadius="8"
                                Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding SenderName}" FontWeight="Bold" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding TimeFormatted, StringFormat=' ({0})'}" FontSize="10" Foreground="#64748B"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Foreground="White"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- INPUT AREA -->
        <StackPanel Grid.Row="2">
            <Grid IsEnabled="{Binding AllowStudentReply}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="8,6"
                         FontSize="12" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Gửi" Command="{Binding SendCommand}"
                        Background="#3B82F6" Foreground="White" FontWeight="Bold"
                        Padding="14,6" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                </Button>
            </Grid>

            <!-- Cảnh báo khi giáo viên không cho phép học sinh nhắn tin lại -->
            <TextBlock Text="🔒 Giáo viên đã tạm khóa tính năng phản hồi của học sinh."
                       Foreground="#FBBF24" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AllowStudentReply}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
